# Copy this file to .env and fill in your values.
PORT=4000
DATABASE_URL=postgresql://resolve:resolve@localhost:5432/resolvedesk
# Auto-create tables from entities (fine for development)
DB_SYNC=true
# Set to true for hosted Postgres that requires SSL (Neon, Supabase, Render)
DB_SSL=false
# Frontend URL(s) allowed to call the API, comma-separated
CORS_ORIGIN=http://localhost:3000

# Leave empty to use the built-in rule-based triage
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
