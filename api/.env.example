# Copy this file to .env and fill in your values.
PORT=4000
DATABASE_URL=postgresql://resolve:resolve@localhost:5432/resolvedesk
# Auto-create tables from entities (development only; use false in production)
DB_SYNC=true
# Set to true for hosted Postgres that requires SSL (Neon, Supabase, Render)
DB_SSL=false
# Frontend URL(s) allowed to call the API, comma-separated
CORS_ORIGIN=http://localhost:3000

# --- Agent login (required, the API won't start without these) ---
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# bcrypt hash of the agent password. Run this inside the api folder:
#   node -e "console.log(require('bcrypt').hashSync('your-password-here', 12))"
# Paste the whole hash (it starts with $2b$12$).
AGENT_PASSWORD_HASH=

# --- AI triage (optional) ---
# Leave empty to use the built-in rule-based triage
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
